# ============================================================
# SD WebUI Forge Neo - Root .gitignore
# 排除大文件包和运行时环境，仅保留基础代码
# ============================================================

# 系统运行时 (Python, Git, FFmpeg 等)
system/

# llama.cpp 二进制文件和模型
llama.cpp/

# 界面使用参考图片 (非代码)
ui界面使用参考/

# 启动器非代码资源
launcher/qq群ai交流群.jpg
launcher/主题壁纸.png

# 启动器构建产物
launcher/*.spec
launcher/dist/
launcher/build/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# Local extensions, models, outputs and runtime caches (keep local only)
webui/extensions/*/
webui/models/
webui/outputs/
webui/extensions/tmp/
webui/extensions/*/see-through/workspace/
webui/extensions/*/outputs/
# Publish only the two requested extensions
!webui/extensions/sd-webui-agent-dev-2.4/
!webui/extensions/sd-webui-agent-dev-2.4/**
!webui/extensions/forge-h3-studio/
!webui/extensions/forge-h3-studio/**
webui/extensions/sd-webui-agent-dev-2.4/outputs/
webui/extensions/sd-webui-agent-dev-2.4/tmp/
webui/extensions/sd-webui-agent-dev-2.4/data/agent_memory.json

# Generated caches and local databases
**/__pycache__/
**/*.py[cod]
**/.cache/
**/cache/
**/*.db
**/*.db-shm
**/*.db-wal

# Large model and runtime artifact formats
**/*.safetensors
**/*.ckpt
**/*.pth
**/*.pt
**/*.bin
**/*.onnx
**/*.h5
**/*.msgpack
**/*.incomplete

.agent_backups/
.trae/
_launch_tmp_*.bat

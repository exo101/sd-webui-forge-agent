# ============================================================
# SD WebUI Forge Neo - Root .gitignore
# 排除大文件包和运行时环境，仅保留基础代码
# ============================================================

# 系统运行时 (Python, Git, FFmpeg 等)
system/

# llama.cpp 二进制文件和模型
llama.cpp/

# 界面使用参考图片 (非代码)
ui界面使用参考/
ui界面*参考/
ui界面*标准/

# 启动器非代码资源
launcher/qq群ai交流群.jpg
launcher/主题壁纸.png

# 启动器构建产物
launcher/*.spec
launcher/dist/
launcher/build/
launcher/build_tmp/

# HuggingFace 运行时模型缓存
webui/backend/huggingface/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# Local extensions, models, outputs and runtime caches (keep local only)
webui/extensions/*/
webui/models/
webui/outputs/
webui/extensions/tmp/
webui/extensions/*/see-through/workspace/
webui/extensions/*/outputs/
# Publish only the requested extensions
!webui/extensions/sd-webui-agent-dev-2.5/
!webui/extensions/sd-webui-agent-dev-2.5/**
!webui/extensions/forge-h3-studio/
!webui/extensions/forge-h3-studio/**
!webui/extensions/sd-webui-ps-plugin-api/
!webui/extensions/sd-webui-ps-plugin-api/**
!webui/extensions/sd-webui-model_downloader/
!webui/extensions/sd-webui-model_downloader/**
!webui/extensions/TE-webui-DLSS5/
!webui/extensions/TE-webui-DLSS5/**
# DLSS5 大体积运行时（NVIDIA NGX DLL / DepthAnything 模型 / DirectML）不入库，需另行获取
webui/extensions/TE-webui-DLSS5/**/*.dll
webui/extensions/TE-webui-DLSS5/**/models/
webui/extensions/TE-webui-DLSS5/**/__pycache__/
# 保留核心桥接 DLL（体积小，必需）
!webui/extensions/TE-webui-DLSS5/te_dlss5/te_dlss5_native.dll
!webui/extensions/TE-webui-DLSS5/te_dlss5/te_nvof_cuda.dll
!webui/extensions/sd-webui-forge-neo-seedvr2/
!webui/extensions/sd-webui-forge-neo-seedvr2/**
webui/extensions/sd-webui-forge-neo-seedvr2/**/__pycache__/
webui/extensions/sd-webui-forge-neo-seedvr2/**/*.pyc
webui/extensions/sd-webui-agent-dev-2.5/outputs/
webui/extensions/sd-webui-agent-dev-2.5/tmp/
webui/extensions/sd-webui-agent-dev-2.5/data/agent_memory.json

# Generated caches and local databases
**/__pycache__/
**/*.py[cod]
**/.cache/
**/cache/
**/*.db
**/*.db-shm
**/*.db-wal

# Large model and runtime artifact formats
**/*.safetensors
**/*.ckpt
**/*.pth
**/*.pt
**/*.bin
**/*.onnx
**/*.h5
**/*.msgpack
**/*.incomplete

.agent_backups/
.trae/
_launch_tmp_*.bat

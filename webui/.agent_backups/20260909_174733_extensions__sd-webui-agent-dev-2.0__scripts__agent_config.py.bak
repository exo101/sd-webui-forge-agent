}

API_PROVIDERS = {
    "ModelScope": {
        "base_url": "https://api-inference.modelscope.cn/v1",
        "note": "ModelScope API",
    },
    "YoboxAI": {
        "base_url": "https://api.yoboxai.com/v1",
        "note": "YoboxAI API，支持 GPT Image 2、Nano Banana、Gemini 3 Pro、Gemini Flash Lite、Gemini Flash、MiniMax H3 等模型标签",

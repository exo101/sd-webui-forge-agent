EXT_DIR = Path(__file__).parent.parent
CONFIG_PATH = EXT_DIR / "agent_config.json"

# 端口 → 模型关键词映射（用户的启动器规则）
# 8080=4B, 8079=2B, 其余端口自动选第一个模型
PORT_MODEL_MAP = {
    8080: ("4b", "4B"),
    8079: ("2b", "2B"),
}
LLAMA_PORT_SCAN = list(range(8079, 8091))  # 扫描 8079-8090


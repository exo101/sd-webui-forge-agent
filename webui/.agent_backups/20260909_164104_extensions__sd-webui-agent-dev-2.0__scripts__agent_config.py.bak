    "api_key": "",
    "api_provider": "ModelScope",
    "base_url": "https://api-inference.modelscope.cn/v1",
    "model": "Qwen/Qwen3.8-27B",
    "image_api_key": "",
    "image_api_provider": "ModelScope",
